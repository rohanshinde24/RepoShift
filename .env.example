# Default zero-cloud-spend mode. Enable only after setting a budget.
REPOSHIFT_ALLOW_PAID=0
DATABASE_URL=postgres://reposhift:reposhift@127.0.0.1:55432/reposhift
REPOSHIFT_API_TOKEN=replace-with-a-long-random-token
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
AZURE_OPENAI_API_KEY=
REPOSHIFT_RUNNER_IMAGE=reposhift-runner:dev
# Zero-cost local model mode; requires a running Ollama server and installed model.
REPOSHIFT_OLLAMA_MODEL=qwen2.5:7b
# GitHub publication is disabled unless these are explicitly configured.
GITHUB_TOKEN=
REPOSHIFT_GITHUB_REPOSITORY=

# Public GitHub inputs only; comma-separated owner/repo allowlist.
REPOSHIFT_ALLOWED_REPOSITORIES=
