{
  "name": "reposhift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests scripts eslint.config.js",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "format": "prettier --write src tests scripts runner/check.cjs eslint.config.js",
    "format:check": "prettier --check src tests scripts runner/check.cjs eslint.config.js",
    "demo:local": "tsx scripts/local-demo.ts",
    "test:workers": "tsx --test tests/integration/task-workers.test.ts",
    "pilot:local-model": "tsx scripts/local-model-pilot.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "^10.12.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript-eslint": "^8.71.1"
  }
}
